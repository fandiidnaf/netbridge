#!/usr/bin/env bash
# NetBridge Git Pre-Push Hook: Enforces tags must originate from main branch.

while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ "$remote_ref" =~ refs/tags/v* ]]; then
    if ! git merge-base --is-ancestor "$local_oid" main; then
      echo "------------------------------------------------------------------"
      echo "ERROR: Refusing to push tag '$remote_ref'"
      echo "Commit $local_oid is not on the 'main' branch."
      echo "Releases and version tags must strictly originate from 'main'."
      echo "------------------------------------------------------------------"
      exit 1
    fi
  fi
done

exit 0
